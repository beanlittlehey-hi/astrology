page {
  min-height: 100%;
  background: #f8f4ff;
  color: #282342;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1.2;
  background: transparent;
  color: inherit;
  font: inherit;
}

button::after {
  border: 0;
}
