/* Tarot draw deck */
.deck-area {
  min-height: 600rpx;
  padding: 34rpx 34rpx 28rpx;
  border: 2rpx dashed rgba(202, 181, 255, 0.5);
  border-radius: 18rpx;
  overflow: visible;
  background:
    radial-gradient(circle at 50% 38%, rgba(206, 237, 255, 0.58), transparent 42%),
    rgba(255, 255, 255, 0.62);
}

.deck-area .deck-title {
  margin-bottom: 22rpx;
  font-size: 27rpx;
}

.deck-stack {
  width: 100%;
  height: 310rpx;
  margin: 0 auto 18rpx;
  position: relative;
  display: block;
  overflow: visible;
}

.deck-card {
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  width: 118rpx;
  height: 188rpx;
  margin-left: -59rpx;
  border-radius: 14rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 34rpx rgba(36, 31, 61, 0.16);
  transform-origin: 50% 112%;
  transition: transform 0.42s ease, bottom 0.42s ease;
}

.deck-card:nth-child(1) { transform: translateX(-260rpx) rotate(-42deg); }
.deck-card:nth-child(2) { transform: translateX(-214rpx) rotate(-34deg); }
.deck-card:nth-child(3) { transform: translateX(-168rpx) rotate(-26deg); }
.deck-card:nth-child(4) { transform: translateX(-122rpx) rotate(-18deg); }
.deck-card:nth-child(5) { transform: translateX(-76rpx) rotate(-10deg); }
.deck-card:nth-child(6) { transform: translateX(-30rpx) rotate(-3deg); }
.deck-card:nth-child(7) { transform: translateX(18rpx) rotate(4deg); }
.deck-card:nth-child(8) { transform: translateX(66rpx) rotate(12deg); }
.deck-card:nth-child(9) { transform: translateX(114rpx) rotate(20deg); }
.deck-card:nth-child(10) { transform: translateX(162rpx) rotate(28deg); }
.deck-card:nth-child(11) { transform: translateX(210rpx) rotate(36deg); }
.deck-card:nth-child(12) { transform: translateX(258rpx) rotate(44deg); }

.deck-stack.shuffling .deck-card:nth-child(odd) {
  bottom: 46rpx;
  transform: translateX(-30rpx) rotate(-7deg);
  animation: deckShuffleOdd 0.9s ease-in-out;
}

.deck-stack.shuffling .deck-card:nth-child(even) {
  bottom: 34rpx;
  transform: translateX(34rpx) rotate(8deg);
  animation: deckShuffleEven 0.9s ease-in-out;
}

.deck-stack.shuffled .deck-card:nth-child(1) { transform: translateX(-272rpx) rotate(-45deg); }
.deck-stack.shuffled .deck-card:nth-child(2) { transform: translateX(-220rpx) rotate(-36deg); }
.deck-stack.shuffled .deck-card:nth-child(3) { transform: translateX(-172rpx) rotate(-27deg); }
.deck-stack.shuffled .deck-card:nth-child(4) { transform: translateX(-122rpx) rotate(-18deg); }
.deck-stack.shuffled .deck-card:nth-child(5) { transform: translateX(-74rpx) rotate(-10deg); }
.deck-stack.shuffled .deck-card:nth-child(6) { transform: translateX(-26rpx) rotate(-2deg); }
.deck-stack.shuffled .deck-card:nth-child(7) { transform: translateX(24rpx) rotate(6deg); }
.deck-stack.shuffled .deck-card:nth-child(8) { transform: translateX(74rpx) rotate(14deg); }
.deck-stack.shuffled .deck-card:nth-child(9) { transform: translateX(124rpx) rotate(22deg); }
.deck-stack.shuffled .deck-card:nth-child(10) { transform: translateX(174rpx) rotate(30deg); }
.deck-stack.shuffled .deck-card:nth-child(11) { transform: translateX(224rpx) rotate(38deg); }
.deck-stack.shuffled .deck-card:nth-child(12) { transform: translateX(274rpx) rotate(46deg); }

@keyframes deckShuffleOdd {
  0% { transform: translateX(-230rpx) rotate(-32deg); }
  38% { transform: translateX(96rpx) rotate(12deg); }
  72% { transform: translateX(-64rpx) rotate(-12deg); }
  100% { transform: translateX(-30rpx) rotate(-7deg); }
}

@keyframes deckShuffleEven {
  0% { transform: translateX(220rpx) rotate(34deg); }
  38% { transform: translateX(-110rpx) rotate(-14deg); }
  72% { transform: translateX(74rpx) rotate(13deg); }
  100% { transform: translateX(34rpx) rotate(8deg); }
}

