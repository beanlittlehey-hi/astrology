  box-shadow: 0 24rpx 56rpx rgba(87, 99, 132, 0.08);
}

.splash-primary {
  width: 100%;
  min-height: 96rpx;
  margin-top: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #8595c8 0%, #a996df 58%, #bc903a 100%);
  box-shadow: 0 18rpx 38rpx rgba(87, 99, 132, 0.18);
}

.auth-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(70, 78, 104, 0.22);
  backdrop-filter: blur(8rpx);
}

.auth-sheet {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(26rpx + env(safe-area-inset-bottom));
  z-index: 1201;
  padding: 22rpx 28rpx 32rpx;
  border-radius: 34rpx;
  border: 2rpx solid rgba(143, 154, 198, 0.16);
  background:
    radial-gradient(circle at 92% 0, rgba(255, 250, 240, 0.72), transparent 36%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(238, 245, 251, 0.92));
  box-shadow: 0 -18rpx 54rpx rgba(87, 99, 132, 0.16);
}

.auth-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: rgba(143, 154, 198, 0.26);
}

.auth-sheet-head {
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: center;
  margin-bottom: 22rpx;
}

.auth-sheet-head .panel-title {
  display: block;
  color: #27365c;
  font-size: 31rpx;
  font-weight: 900;
}

.auth-sheet-head .muted {
  display: block;
  margin-top: 8rpx;
  color: #8790aa;
  font-size: 24rpx;
  line-height: 1.4;
}

.auth-primary {
  margin-top: 0;
}

.auth-cancel {
  min-height: 80rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
}

.auth-note {
  display: block;
  margin-top: 20rpx;
  color: #8790aa;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.wechat-login-mark {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #2fc777;
  box-shadow: 0 14rpx 32rpx rgba(47, 199, 119, 0.2);
  font-size: 32rpx;
  font-weight: 900;
}

/* home-v2 final editable homepage */
.home-v2-screen {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  background: #efeaff;
}

.home-v2-screen::before {
  display: none;
}

.home-v2-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.home-v2-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 112rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
  overflow: visible;
  background: transparent;
}

.home-v2-profile {
  width: auto;
  max-width: 100%;
  min-height: 64rpx;
  margin: 0 0 56rpx 18rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  color: #4d5f9e;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 700;
  text-align: left;
}

.home-v2-primary::after,
.home-v2-screen .bottom-nav .nav-item::after {
  border: 0;
}

.home-v2-avatar {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #7d83ff 0%, #9c75ff 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  box-shadow: 0 8rpx 18rpx rgba(104, 109, 207, 0.18);
  font-size: 32rpx;
  font-weight: 900;
}

.home-v2-greeting {
  display: block;
  padding-top: 2rpx;
}

.home-v2-card {
  position: relative;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 0;
  background: transparent;
  box-shadow: 0 18rpx 34rpx rgba(121, 107, 170, 0.08);
}

.home-v2-card > .home-card-bg {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  right: auto !important;
  width: 100% !important;
  height: 100% !important;
  opacity: 1 !important;
  z-index: 0 !important;
  transform: none !important;
  border-radius: inherit !important;
}

.home-v2-hero {
  min-height: 470rpx;
  margin: 0 0 28rpx;
  padding: 70rpx 46rpx 46rpx;
  border-radius: 34rpx;
}

.home-v2-hero .home-card-copy {
  position: relative;
  z-index: 2;
  width: 335rpx;
}

.home-v2-content .eyebrow {
  display: block;
  margin: 0 0 46rpx;
  color: #253f9a;
  font-size: 58rpx;
  line-height: 1.05;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.home-v2-content .hero-title {
  display: block;
  width: 310rpx;
  color: #64719f;
  font-size: 28rpx;
  line-height: 1.65;
  font-weight: 700;
}

.home-v2-primary {
  position: relative;
  overflow: hidden;
  width: 300rpx;
  height: 96rpx;
  min-height: 96rpx;
  margin: 46rpx 0 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: transparent;
  box-shadow: 0 12rpx 28rpx rgba(126, 110, 226, 0.26);
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-v2-primary-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.home-v2-primary text {
  position: relative;
  z-index: 1;
  color: #ffffff;
}

.home-v2-tarot {
  position: absolute;
  z-index: 2;
  right: 42rpx;
  top: 88rpx;
  width: 205rpx;
  height: 305rpx;
  filter: drop-shadow(0 14rpx 22rpx rgba(69, 62, 111, 0.24));
  transform: rotate(5deg);
}

.home-v2-small-card {
  width: 100%;
  height: 196rpx;
  min-height: 196rpx;
  margin: 0 0 26rpx;
  padding: 32rpx 44rpx;
  border-radius: 30rpx;
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  text-align: left;
  line-height: normal;
}

.home-v2-small-card .mini-icon-img,
.home-v2-small-card .home-card-small-right-bg,
.home-v2-small-card .home-small-copy,
.home-v2-small-card .list-copy {
  position: relative;
  z-index: 2;
}

.home-v2-small-card .home-card-small-right-bg {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 260rpx;
  height: 150rpx;
  z-index: 1;
  opacity: 0.92;
  pointer-events: none;
}

.home-v2-small-card .mini-icon-img {
  width: 112rpx;
  height: 112rpx;
  justify-self: center;
}

.home-v2-small-card .home-small-copy,
.home-v2-small-card .list-copy {
  min-width: 0;
  max-width: 430rpx;
  justify-self: start;
  text-align: left;
}

.home-v2-small-card.home-journal-card .list-copy {
  width: calc(100vw - 276rpx);
  max-width: none;
}

.home-v2-content .panel-title {
  display: block;
  color: #293f8f;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.home-v2-content .muted,
.home-v2-content .tags {
  display: block;
  margin-top: 14rpx;
  color: #65709a;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 700;
}

.home-v2-content .home-journal-card .row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  width: 100%;
}

.home-v2-content .home-journal-card .time {
  flex-shrink: 0;
  margin-left: auto;
  color: #425cb3;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: right;
  max-width: 250rpx;
}

.home-v2-content .home-journal-card .clamp {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page > .bottom-nav {
  height: calc(126rpx + env(safe-area-inset-bottom));
  padding: 0 82rpx env(safe-area-inset-bottom);
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  background: transparent;
  border-top: 0;
  box-shadow: none;
  pointer-events: none;
}

.page > .bottom-nav .bottom-nav-bg {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 118rpx;
  z-index: 0;
  pointer-events: none;
}

.page > .bottom-nav .nav-item {
  position: relative;
  z-index: 1;
  pointer-events: auto;
  align-self: end;
  height: 118rpx;
  padding: 0;
  gap: 0;
  color: #7d86ad;
  background: transparent;
  border: 0;
  box-shadow: none;
  font-size: 28rpx;
  font-weight: 800;
}

.page > .bottom-nav .nav-item text {
  width: auto;
  color: inherit;
  line-height: 1;
}

.page > .bottom-nav .nav-icon {
  width: 76rpx;
  height: 76rpx;
  display: block;
  flex-shrink: 0;
}

.page > .bottom-nav .nav-item.active {
  color: #566bc6;
}
