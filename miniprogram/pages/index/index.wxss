  --shadow-soft: 0 16rpx 34rpx rgba(87, 99, 132, 0.1);
  --shadow-card: 0 18rpx 38rpx rgba(87, 99, 132, 0.12);
  color: var(--ink);
  background:
    radial-gradient(circle at 14% 10%, rgba(196, 215, 233, 0.38), transparent 28%),
