.page {
  --bg: #fffdf8;
  --paper: #fffaf1;
  --ink: #1f2430;
  --muted: #667085;
  --line: #d8d2c8;
  --soft: #f1e9df;
  --violet: #6b5cff;
  --teal: #177e89;
  --rose: #bf5b75;
  --amber: #b87913;
  --green: #3b7a57;
  min-height: 100vh;
  color: #1f2430;
  background: #fffdf8;
}

.screen {
  min-height: 100vh;
  background: #fffdf8;
}

.app-screen {
  display: flex;
  flex-direction: column;
}

.status {
  height: 56rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #293241;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  background: rgba(255, 253, 248, 0.94);
}

.home-status {
  height: 56rpx;
  padding: 0 32rpx;
  color: #293241;
  background: rgba(255, 253, 248, 0.94);
  border-bottom: 0;
}

.content {
  flex: 1;
  overflow: hidden;
  padding: 36rpx;
}

.with-nav {
  padding-bottom: 150rpx;
}

.home-content {
  position: relative;
  overflow: hidden;
  padding: 36rpx 36rpx 150rpx;
  background: #fffdf8;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.topbar > view {
  flex: 1;
  min-width: 0;
}

.h1 {
  display: block;
  color: #1f2430;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 0;
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.primary,
.secondary,
.ghost {
  width: 100%;
  min-height: 84rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #6b5cff;
  font-size: 28rpx;
  font-weight: 800;
  border: 2rpx solid transparent;
}

.secondary {
  background: #177e89;
}

.ghost {
  color: #354052;
  background: #fffdf8;
  border-color: #d8d2c8;
}

.small {
  min-height: 72rpx;
  font-size: 24rpx;
}

.legal {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #667085;
  background: #f4f4f5;
  font-size: 22rpx;
  line-height: 1.55;
}

.splash {
  padding: 108rpx 52rpx 72rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background:
    linear-gradient(160deg, rgba(107, 92, 255, 0.16), transparent 38%),
    linear-gradient(25deg, rgba(23, 126, 137, 0.14), transparent 42%),
    #fffdf8;
}

.brand-mark {
  width: 236rpx;
  height: 236rpx;
  margin-bottom: 44rpx;
  border-radius: 56rpx;
  display: grid;
  place-items: center;
  position: relative;
  color: #6b5cff;
  background: #eee5f9;
  border: 2rpx solid #d9c9ef;
}

.card-shadow,
.card-logo {
  position: absolute;
  width: 88rpx;
  height: 124rpx;
  border-radius: 16rpx;
}

.card-shadow {
  left: 74rpx;
  top: 60rpx;
  transform: rotate(-9deg);
  background: rgba(31, 36, 48, 0.08);
}

.card-logo {
  left: 92rpx;
  top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #11100e;
  border: 6rpx solid #f5f0df;
}

.card-logo text {
  color: #f0c84b;
  font-size: 44rpx;
}

.eye {
  width: 48rpx;
  height: 22rpx;
  border: 4rpx solid #f5f0df;
  border-radius: 50%;
}

.splash-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.kicker {
  color: #667085;
  font-size: 24rpx;
}

.title {
  color: #1f2430;
  font-size: 68rpx;
  line-height: 1.15;
  font-weight: 900;
}

.desc {
  color: #667085;
  font-size: 28rpx;
  line-height: 1.7;
}

.bottom-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.splash .legal {
  margin-top: 0;
}

.login-card,
.hero-card,
.panel,
.list-item,
.choice,
.result-block,
.drawer,
.reader-cta,
.timeline-item,
.question-compose {
  border: 2rpx solid #d8d2c8;
  border-radius: 16rpx;
  background: #fffaf1;
}

.login-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.wechat-login-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: #20b767;
  font-size: 36rpx;
  font-weight: 900;
}

.section-title,
.panel-title {
  display: block;
  color: #1f2430;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 900;
}

.muted {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.tags {
  display: block;
  margin-top: 8rpx;
  color: #177e89;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 800;
}

.profile-entry {
  width: auto;
  min-width: 0;
  min-height: 74rpx;
  padding: 10rpx 16rpx 10rpx 10rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  color: #354052;
  background: #fffaf1;
  border: 2rpx solid #d8d2c8;
  font-size: 24rpx;
  font-weight: 900;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #177e89;
  font-size: 24rpx;
  font-weight: 900;
}

.avatar.large {
  width: 88rpx;
  height: 88rpx;
}

.hero-card {
  padding: 32rpx;
  min-height: 264rpx;
  margin-bottom: 24rpx;
  background: #eee5f9;
  border-color: #d7c7f1;
}

.daily-draw-card {
  text-align: left;
}

.eyebrow {
  display: block;
  margin-bottom: 16rpx;
  color: #1f2430;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 900;
}

.hero-title {
  display: block;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.55;
}

.quick-row,
.grid-2 {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 20rpx;
  margin: 24rpx 0;
}

.quick-row.single {
  grid-template-columns: 1fr;
}

.panel,
.link-card {
  padding: 24rpx;
  text-align: left;
}

.mini-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.teal { background: #177e89; }
.rose { background: #bf5b75; }
.violet { background: #6b5cff; }
.amber { background: #b87913; }
.green { background: #3b7a57; }

.list-item {
  width: 100%;
  padding: 24rpx;
  display: grid;
  grid-template-columns: 68rpx 1fr;
  gap: 20rpx;
  align-items: start;
  text-align: left;
}

.list-copy {
  min-width: 0;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.time {
  color: #667085;
  font-size: 20rpx;
  white-space: nowrap;
}

.clamp {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.drawer-layer {
  position: fixed;
  inset: 0;
  z-index: 8;
  background: rgba(31, 36, 48, 0.22);
}

.drawer {
  position: fixed;
  top: 56rpx;
  right: 0;
  bottom: 0;
  z-index: 9;
  width: 496rpx;
  padding: 32rpx;
  border-radius: 0;
  border-top: 0;
  border-right: 0;
  border-bottom: 0;
  box-shadow: -24rpx 0 56rpx rgba(31, 36, 48, 0.14);
}

.drawer-head {
  display: grid;
  grid-template-columns: 88rpx 1fr;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 24rpx;
}

.settings-row {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: #1f2430;
  border-bottom: 2rpx solid #d8d2c8;
  font-size: 26rpx;
  font-weight: 800;
}

.settings-row text:last-child {
  color: #667085;
  font-size: 24rpx;
  font-weight: 500;
}

.icon-btn {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #354052;
  background: #fffaf1;
  border: 2rpx solid #d8d2c8;
  font-size: 34rpx;
  font-weight: 900;
}

.today-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #d8d2c8;
  border-radius: 16rpx;
  display: grid;
  grid-template-columns: 156rpx 1fr;
  gap: 24rpx;
  align-items: center;
  background: #fffaf1;
}

.today-image {
  width: 156rpx;
  height: 224rpx;
  border-radius: 16rpx;
  display: block;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 34rpx rgba(126, 97, 210, 0.12);
  background: rgba(255, 255, 255, 0.72);
}

.card-face {
  height: 224rpx;
  border-radius: 16rpx;
  display: grid;
  place-items: center;
  text-align: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  border: 4rpx solid rgba(255, 255, 255, 0.62);
  background:
    radial-gradient(circle at 50% 30%, rgba(184, 121, 19, 0.9) 0 12rpx, transparent 14rpx),
    linear-gradient(135deg, rgba(107, 92, 255, 0.94), rgba(191, 91, 117, 0.9));
}

.result-block {
  padding: 24rpx;
  margin-top: 20rpx;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 16rpx;
}

.insight-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.74);
  border: 2rpx solid rgba(202, 181, 255, 0.22);
}

.insight-title {
  color: #282342;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.insight-meta {
  color: #7d6f8d;
  font-size: 21rpx;
  line-height: 1.4;
}

.accent {
  background: #e8f4f2;
  border-color: #bdddd9;
}

.warn {
  background: #fff2f4;
  border-color: #edc4cd;
}

.textarea-input {
  width: 100%;
  min-height: 164rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #1f2430;
  background: #fffdf8;
  border: 2rpx solid #d8d2c8;
  font-size: 24rpx;
  line-height: 1.5;
}

.textarea-input.tall {
  min-height: 224rpx;
  margin-top: 20rpx;
}

.result-note-card {
  background: #fffdf8;
}

.question-label {
  margin: 8rpx 0 18rpx;
  color: #1f2430;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 900;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 18rpx 0 24rpx;
}

.chip {
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  background: #fffdf8;
  border: 2rpx solid #d8d2c8;
  font-size: 24rpx;
  white-space: nowrap;
}

.chip.on {
  color: #ffffff;
  background: #bf5b75;
  border-color: #bf5b75;
  font-weight: 900;
}

.question-hint {
  margin: -8rpx 0 16rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.spread-list {
  display: grid;
  gap: 16rpx;
}

.choice {
  width: 100%;
  min-height: 128rpx;
  padding: 20rpx 24rpx;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24rpx;
  align-items: center;
  text-align: left;
}

.choice.active {
  border-color: #6b5cff;
  box-shadow: 0 0 0 4rpx rgba(107, 92, 255, 0.12);
}

.choice.disabled {
  opacity: 0.42;
}

.badge {
  min-width: 96rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #177e89;
  background: #e8f4f2;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.stepper {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  gap: 12rpx;
  margin: 20rpx 0 24rpx;
}

.step {
  height: 14rpx;
  border-radius: 999rpx;
  background: #e3d9cf;
}

.step.on {
  background: #6b5cff;
}

.question-compose {
  margin: 24rpx 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 28rpx 60rpx rgba(93, 73, 142, 0.08);
}

.compose-label {
  display: block;
  margin-bottom: 16rpx;
  color: #1f2430;
  font-size: 24rpx;
  font-weight: 900;
}

.question-compose textarea {
  width: 100%;
  min-height: 128rpx;
  padding: 20rpx;
  border: 2rpx solid #d8d2c8;
  border-radius: 16rpx;
  color: #1f2430;
  background: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.45;
}

.question-confirm {
  width: 100%;
  min-height: 72rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #a78bfa, #7c3cff);
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 24rpx 48rpx rgba(124, 60, 255, 0.14);
}

.deck-area {
  position: relative;
  min-height: 472rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 2rpx dashed #b8ab9d;
  border-radius: 16rpx;
  background: #f5efe5;
}

.deck-title {
  display: flex;
  justify-content: space-between;
  color: #1f2430;
  font-size: 24rpx;
  font-weight: 900;
}

.deck-stack {
  position: relative;
  width: 212rpx;
  height: 284rpx;
  margin: 24rpx auto 0;
  display: block;
}

.deck-stack view {
  position: absolute;
  inset: 0;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.62);
  background:
    radial-gradient(circle at 50% 30%, rgba(184, 121, 19, 0.9) 0 12rpx, transparent 14rpx),
    linear-gradient(135deg, rgba(107, 92, 255, 0.94), rgba(191, 91, 117, 0.9));
  box-shadow: 0 20rpx 36rpx rgba(31, 36, 48, 0.12);
}

.deck-stack view:nth-child(1) { transform: translate(-20rpx, 20rpx) rotate(-8deg); opacity: 0.5; }
.deck-stack view:nth-child(2) { transform: translate(-8rpx, 8rpx) rotate(-3deg); opacity: 0.72; }
.deck-stack view:nth-child(3) { transform: translate(6rpx, 0) rotate(2deg); }
.deck-stack view:nth-child(4) { transform: translate(16rpx, -6rpx) rotate(5deg); opacity: 0.76; }
.deck-stack view:nth-child(5) { transform: translate(24rpx, -10rpx) rotate(8deg); opacity: 0.44; }
.deck-stack.shuffled view:nth-child(1) { transform: translate(-52rpx, 24rpx) rotate(-16deg); }
.deck-stack.shuffled view:nth-child(2) { transform: translate(-26rpx, 10rpx) rotate(-8deg); }
.deck-stack.shuffled view:nth-child(4) { transform: translate(34rpx, -8rpx) rotate(12deg); }
.deck-stack.shuffled view:nth-child(5) { transform: translate(58rpx, -18rpx) rotate(18deg); }

.deck-actions {
  display: grid;
  gap: 12rpx;
  margin-top: 24rpx;
}

.shuffle-btn,
.deck-status {
  min-height: 68rpx;
  border-radius: 999rpx;
  display: grid;
  place-items: center;
  color: #ffffff;
  background: #6b5cff;
  font-size: 24rpx;
  font-weight: 900;
}

.deck-status {
  color: #667085;
  background: transparent;
}

.deck-hint {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  color: #1f2430;
  background: rgba(255, 253, 248, 0.9);
  border: 2rpx solid rgba(184, 171, 157, 0.72);
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 900;
}

.drawn {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
}

.tarot-mini {
  min-height: 308rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  text-align: center;
  background: #fffdf8;
  border: 2rpx solid #d8d2c8;
}

.tarot-mini image,
.card-back {
  width: 100%;
  height: 188rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  display: grid;
  place-items: center;
  color: #ffffff;
  background:
    radial-gradient(circle at 50% 30%, rgba(184, 121, 19, 0.9) 0 10rpx, transparent 12rpx),
    linear-gradient(135deg, rgba(107, 92, 255, 0.94), rgba(191, 91, 117, 0.9));
  font-size: 22rpx;
  font-weight: 900;
}

.tarot-mini .panel-title,
.tarot-mini .muted {
  font-size: 22rpx;
}

.card-row-scroll {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  margin-bottom: 18rpx;
}

.result-card {
  width: 188rpx;
  flex: 0 0 188rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #fffdf8;
  border: 2rpx solid #d8d2c8;
}

.result-card image {
  width: 100%;
  height: 238rpx;
  border-radius: 12rpx;
  background: #1f2430;
}

.crystal-hero {
  min-height: 356rpx;
  padding: 32rpx;
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 28rpx;
  align-items: center;
  background: #eee5f9;
  border: 2rpx solid #d7c7f1;
  border-radius: 16rpx;
}

.crystal-art {
  width: 180rpx;
  height: 220rpx;
  display: grid;
  place-items: center;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 900;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.28), transparent 36%),
    linear-gradient(160deg, #7d67f2 0%, #b55e9e 100%);
  border: 6rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 56rpx 56rpx 36rpx 36rpx;
  box-shadow: 0 28rpx 56rpx rgba(107, 92, 255, 0.18);
}

.crystal-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 24rpx;
}

.crystal-option {
  padding: 20rpx;
  border: 2rpx solid #d8d2c8;
  border-radius: 16rpx;
  background: #fffaf1;
}

.crystal-photo {
  height: 144rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  display: grid;
  place-items: center;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.3), transparent 38%),
    #6b5cff;
}

.reader-cta {
  padding: 24rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 28rpx 60rpx rgba(93, 73, 142, 0.1);
}

.reader-cta text {
  display: block;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.mood-bar {
  height: 148rpx;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  align-items: end;
  margin: 24rpx 0 8rpx;
}

.bar {
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  min-height: 36rpx;
  background: #6b5cff;
}

.bar.anxiety { background: #bf5b75; }
.bar.calm { background: #177e89; }
.bar.hesitate { background: #b87913; }
