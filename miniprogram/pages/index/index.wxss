  position: fixed;
  top: 0;
  left: 0;
  right: auto;
  bottom: 0;
  z-index: 1201;
  width: 72vw;
  max-width: 560rpx;
  box-sizing: border-box;
  padding: calc(64rpx + env(safe-area-inset-top)) 36rpx 46rpx;
  overflow-y: auto;
