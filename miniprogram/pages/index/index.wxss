.pile-card-8 { transform: translate(0, 76rpx) rotate(4deg); }
.pile-card-9 { transform: translate(86rpx, 82rpx) rotate(16deg); }
.pile-card-10 { transform: translate(154rpx, 132rpx) rotate(28deg); }
.pile-card-11 { transform: translate(0, 18rpx) rotate(-2deg); z-index: 2; }

.deck-pile.shuffling .pile-card:nth-child(odd) {
  animation: pileShuffleOdd 0.9s ease-in-out;
}

.deck-pile.shuffling .pile-card:nth-child(even) {
  animation: pileShuffleEven 0.9s ease-in-out;
}

@keyframes pileShuffleOdd {
  0% { transform: translate(-120rpx, 40rpx) rotate(-22deg); }
  45% { transform: translate(104rpx, 22rpx) rotate(18deg); }
  100% { transform: translate(-20rpx, 64rpx) rotate(-5deg); }
}

@keyframes pileShuffleEven {
  0% { transform: translate(122rpx, 60rpx) rotate(24deg); }
  45% { transform: translate(-108rpx, 18rpx) rotate(-18deg); }
  100% { transform: translate(20rpx, 58rpx) rotate(6deg); }
}

