/* V0.2 latest global skin */
.page {
  --bg: #f4f1eb;
  --paper: rgba(255, 250, 240, 0.92);
  --panel: rgba(255, 255, 255, 0.76);
  --panel-strong: rgba(255, 255, 255, 0.92);
  --ink: #27365c;
  --muted: #6b7390;
