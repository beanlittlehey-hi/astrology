.mood-legend {
  display: flex;
  justify-content: space-between;
  color: #667085;
  font-size: 22rpx;
}

.timeline {
  display: grid;
  gap: 20rpx;
  margin-top: 24rpx;
  position: relative;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 32rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 2rpx;
  background: #d8d2c8;
}

.timeline-item {
  width: 100%;
  padding: 24rpx 24rpx 24rpx 84rpx;
  position: relative;
  text-align: left;
  background: #fffdf8;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 34rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #bf5b75;
  border: 4rpx solid #fffdf8;
  box-shadow: 0 0 0 2rpx #d8d2c8;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 7;
  width: 100%;
  height: 124rpx;
  padding: 14rpx 36rpx 18rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  background: rgba(255, 253, 248, 0.96);
  border-top: 2rpx solid #d8d2c8;
}

.nav-item {
  width: 100%;
  min-width: 0;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.25;
}

.nav-item text {
  display: block;
  width: 100%;
  text-align: center;
  white-space: nowrap;
}

.nav-indicator {
  width: 44rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: transparent;
}

.nav-item.active {
